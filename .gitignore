.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Julia generated files
*.ji
*.jls

# Heavy profiler outputs
artifacts/profiles/*.nsys-rep
artifacts/profiles/*.qdrep
artifacts/profiles/*.sqlite

# Temporary logs; curated summaries should be copied into Markdown when important
artifacts/logs/*.tmp
artifacts/logs/*.trace

# Local machine notes
.local/
.env
temp/
*.jld2

# Generated static-scaling binary artifacts. Manifests, hashes, logs, and
# provenance are committed; regenerate or fetch the arrays from Leonardo.
artifacts/**/*.npz
__pycache__/
*.pyc

# Benchmark presentation build products. The Typst sources (main.typ, slides/,
# components/*.typ) and the final deck (presentation.pdf) are committed; the
# slide renders and the throwaway component test renders are not.
presentations/**/dist/
presentations/**/components/test_*

# Stray Typst compile output at the repository root
/out.pdf

# Notebook execution checkpoints
.ipynb_checkpoints/
