.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Julia generated files
*.ji
*.jls

# Heavy profiler outputs
artifacts/profiles/*.nsys-rep
artifacts/profiles/*.qdrep
artifacts/profiles/*.sqlite

# Temporary logs; curated summaries should be copied into Markdown when important
artifacts/logs/*.tmp
artifacts/logs/*.trace

# Local machine notes
.local/
.env
temp/
*.jld2

# Generated static-scaling binary artifacts. Manifests, hashes, logs, and
# provenance are committed; regenerate or fetch the arrays from Leonardo.
artifacts/**/*.npz
__pycache__/
*.pyc
